{
  "name": "swag",
  "private": true,
  "description": "SWAG (Signal When Arrived, Gremlin!) - Centrale Digital Lab / ECL",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
