<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/swag_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/swag_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="SWAG · Mes enfants"
    android:textColor="#6B4EFF"
    android:textSize="12sp"
    android:textStyle="bold" />

  <LinearLayout
    android:id="@+id/swag_row_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <TextView android:id="@+id/swag_dot_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="16sp" />
    <TextView android:id="@+id/swag_name_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#1B1B2F" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/swag_status_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/swag_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="#6B6B80" android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/swag_row_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <TextView android:id="@+id/swag_dot_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="16sp" />
    <TextView android:id="@+id/swag_name_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#1B1B2F" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/swag_status_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/swag_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="#6B6B80" android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/swag_row_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <TextView android:id="@+id/swag_dot_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="16sp" />
    <TextView android:id="@+id/swag_name_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#1B1B2F" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/swag_status_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/swag_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="#6B6B80" android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/swag_row_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <TextView android:id="@+id/swag_dot_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="16sp" />
    <TextView android:id="@+id/swag_name_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#1B1B2F" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/swag_status_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/swag_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="#6B6B80" android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/swag_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Ouvre SWAG pour afficher tes enfants."
    android:textColor="#6B6B80"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/swag_more"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:textColor="#6B6B80"
    android:textSize="12sp"
    android:visibility="gone" />
</LinearLayout>
