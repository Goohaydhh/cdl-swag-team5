# Base URL of the SWAG API. On a real tablet use your PC's LAN IP, e.g. http://192.168.1.20:3100
VITE_API_URL=http://localhost:3100

# Sprint 0 development token (dev:<familyId>:child:<childId>). Replaced by pairing in Sprint 1.
VITE_DEV_FAMILY_ID=00000000-0000-4000-8000-000000000001
VITE_DEV_CHILD_ID=00000000-0000-4000-8000-000000000002
