    "@nestjs/websockets": "^12.1.2",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@swag/protocol": "workspace:*",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
