# Local development values matching docker-compose.yml. Copy to .env.
PORT=3100
DATABASE_URL=postgresql://swag:swag@localhost:5432/swag
REDIS_URL=redis://localhost:6379

# Browser origins allowed for HTTP and sockets. Native apps send no Origin and are unaffected.
# Add the Vite (5173) and Expo-web (8081) addresses when developing in a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Where drawings are written. Unset = $HOME/swag-media.
# MEDIA_DIR=

# Dead but still required: the API writes media to disk and reads none of these, yet the
# settings schema still validates them. Leave them as they are until they are removed.
S3_ENDPOINT=http://localhost:9000
S3_REGION=fr-par
S3_BUCKET=swag-media
S3_ACCESS_KEY=swag
S3_SECRET_KEY=swag-dev-secret

# Secrets: generate real values for every non-local environment
PAIRING_CODE_PEPPER=change-me
JWT_PRIVATE_KEY_PATH=./keys/jwt-es256.pem

# Firebase service-account JSON, kept outside the repo.
# Unset = pushes are recorded in memory and nothing is sent.
# FCM_SERVICE_ACCOUNT_PATH=

# Giphy (server-side only, never shipped to the apps). Sending GIFs was removed from the apps,
# so this only affects GIFs received before that.
GIPHY_API_KEY=

# Allowed websites ("Sites"): paused for now (product decision), true turns the routes back on
FEATURE_SITES=false

# Accept dev:<family>:<scope>:<id> socket tokens. Never in production.
ALLOW_DEV_TOKENS=true

# Reverse proxies in front of the API (1 behind Caddy in production)
TRUST_PROXY_HOPS=0
