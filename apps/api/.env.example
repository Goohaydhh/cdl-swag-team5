# Local development values matching docker-compose.yml. Copy to .env.
PORT=3100
DATABASE_URL=postgresql://swag:swag@localhost:5432/swag
REDIS_URL=redis://localhost:6379

# S3-compatible storage (RustFS locally, Scaleway Object Storage fr-par in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=fr-par
S3_BUCKET=swag-media
S3_ACCESS_KEY=swag
S3_SECRET_KEY=swag-dev-secret

# Secrets: generate real values for every non-local environment
PAIRING_CODE_PEPPER=change-me
JWT_PRIVATE_KEY_PATH=./keys/jwt-es256.pem

# Giphy (server-side only, never shipped to the apps)
GIPHY_API_KEY=
